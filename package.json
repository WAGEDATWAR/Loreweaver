{
  "name": "loreweaver",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "A local-first web editor for LLM roleplay lorebooks.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test",
    "test:e2e": "node --no-warnings e2e/run.mjs",
    "test:all": "npm test && npm run test:e2e",
    "a11y": "node --no-warnings e2e/a11y.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "contrast": "node scripts/contrast.mjs",
    "bundle": "node scripts/bundle.mjs",
    "apk": "node scripts/build.mjs",
    "apk:debug": "node scripts/build.mjs --variant debug",
    "apk:install": "node scripts/build.mjs --variant debug --install",
    "apk:dry": "node scripts/build.mjs --dry-run",
    "deferrals": "node scripts/deferrals.mjs",
    "deferral-scan": "node scripts/deferral-scan.mjs",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/format.mjs",
    "format:write": "node scripts/format.mjs --write",
    "release:check": "node scripts/release-check.mjs",
    "ui:review": "node --no-warnings scripts/ui-review.mjs",
    "ui:keyboard": "node --no-warnings scripts/ui-keyboard.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "axe-core": "^4.14.0",
    "gpt-tokenizer": "^4.1.0"
  }
}
