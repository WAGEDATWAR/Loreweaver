{
  "name": "Loreweaver",
  "short_name": "Loreweaver",
  "description": "A local-first editor for lorebooks used in LLM roleplay frontends.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0d12",
